node_modules/
.env
.env.*
.wrangler/

# Xcode and SwiftPM
xcuserdata/
UserInterfaceState.xcuserstate
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
.build/
appstore/screenshots/
apps/apple/tests/.coverage/

# Helper bot identity and per-friend keys (local runs)
.bot-seed
.bot-state.json

# Key material is never a repository artefact
*.key
*.pem
!**/*.pub

# Terraform working files
.terraform/
*.tfstate
*.tfstate.*
tfplan
tfplan.json

# Built from native/hqc (nix build .#hqc). The apps get HQC through the
