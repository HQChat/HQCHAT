native/hqc/result

# Cargo build output
core/target/

# The core's Apple libraries: built by core/hqchat-ffi/build-apple.sh, locally
# and by the Apple release workflow, never committed. The generated bindings
# (core/swift/HQChatCore/Sources) are.
core/swift/HQChatCore/HQChatCoreFFI.xcframework/
core/swift/HQChatCore/.built-from

# The Node addon, built by core/hqchat-node/build.sh
core/hqchat-node/hqchat_node.node
dashboards.sh
